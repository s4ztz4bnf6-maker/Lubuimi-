import Mathlib

/-!
An algebraic identity for a prescribed valuation word.
This is a rational affine recurrence lemma only: it does not show that
arbitrary valuation words are realized by positive odd integers, nor that
all Syracuse orbits descend.
-/

namespace SyracuseAudit

/-- Cumulative exponent before step k for a prescribed valuation sequence. -/
def exponent (a : ℕ → ℕ) : ℕ → ℕ
  | 0 => 0
  | k + 1 => exponent a k + a k

/-- Affine offset generated by the same prescribed valuation sequence. -/
def offset (a : ℕ → ℕ) : ℕ → ℕ
  | 0 => 0
  | k + 1 => 3 * offset a k + 2 ^ exponent a k

/--
For a rational trajectory following the affine recurrence
x_(k+1) = (3*x_k+1)/2^(a_k), the cumulative denominator clears all
step denominators and leaves the explicit affine offset.
-/
theorem affine_identity (a : ℕ → ℕ) (x : ℕ → ℚ)
    (hstep : ∀ k, x (k + 1) = (3 * x k + 1) / (2 : ℚ) ^ (a k)) :
    ∀ k, (2 : ℚ) ^ exponent a k * x k =
      (3 : ℚ) ^ k * x 0 + offset a k := by
  intro k
  induction k with
  | zero =>
      simp [exponent, offset]
  | succ k ih =>
      simp only [exponent, offset]
      calc
        (2 : ℚ) ^ (exponent a k + a k) * x (k + 1)
            = (2 : ℚ) ^ exponent a k * (3 * x k + 1) := by
                rw [pow_add, hstep k]
                have hpow : (2 : ℚ) ^ a k ≠ 0 := by positivity
                field_simp
        _ = 3 * ((2 : ℚ) ^ exponent a k * x k) +
              (2 : ℚ) ^ exponent a k := by ring
        _ = (3 : ℚ) ^ (k + 1) * x 0 +
              (3 * offset a k + (2 : ℚ) ^ exponent a k) := by
                rw [ih, pow_succ]
                norm_cast
                ring

#print axioms affine_identity

/--
A repeated state in a deterministic trajectory forces all subsequent
states at the same offset to agree. This is the exact local step behind
the finite-return/periodicity reduction; it makes no Collatz assumption.
-/
theorem repeated_state_periodic {α : Type} (F : α → α) (x : ℕ → α)
    (hstep : ∀ k, x (k + 1) = F (x k))
    {i j : ℕ} (heq : x i = x j) :
    ∀ t, x (i + t) = x (j + t) := by
  intro t
  induction t with
  | zero => simpa using heq
  | succ t ih =>
      calc
        x (i + (t + 1)) = F (x (i + t)) := by
          rw [show i + (t + 1) = (i + t) + 1 by omega, hstep]
        _ = F (x (j + t)) := congrArg F ih
        _ = x (j + (t + 1)) := by
          rw [show j + (t + 1) = (j + t) + 1 by omega, hstep]

/-- The repeated-state lemma has only the standard foundational dependencies. -/
#print axioms repeated_state_periodic

end SyracuseAudit
